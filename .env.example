# Copy this file to .env (local dev) or set these as environment
# variables on your host (Discloud: paste into the dashboard's env
# vars screen). Never commit a real .env file.

DISCORD_TOKEN=
GUILD_ID=

TRANSACTIONS_CHANNEL_ID=
SELF_TRANSACTIONS_CHANNEL_ID=
SCRIM_CHANNEL_ID=

CAPTAIN_ROLE_ID=
VICE_CAPTAIN_ROLE_ID=
# New for NVL: same permissions as Vice Captain everywhere. A team
# can have both a Vice Captain and a Court Captain at the same time.
COURT_CAPTAIN_ROLE_ID=
# REFEREE_ROLE_ID / STREAMER_ROLE_ID: also who's allowed to run
# /match result (cogs.match), in addition to server administrators.
REFEREE_ROLE_ID=
STREAMER_ROLE_ID=
PLAYER_ROLE_ID=
# Comma-separated Discord role IDs allowed to approve/deny roster transfers.
STAFF_APPROVER_ROLE_IDS=

# Required by cogs.matchmaking (/mm), which is loaded by default - NOT
# related to cogs.schedule/cogs.match despite the similar name. Without
# these, /mm organizer commands, queue channel creation, results, and
# ELO updates will silently fail.
# MATCH_ORGANIZER_ROLE_ID: who can run /mm organizer commands (start/finish/cancel queues).
MATCH_ORGANIZER_ROLE_ID=
# MATCHMAKING_CATEGORY_ID: Discord category where /mm creates each queue's text channel.
MATCHMAKING_CATEGORY_ID=
# MM_RESULTS_CHANNEL_ID: channel where finished ranked match results are posted.
MM_RESULTS_CHANNEL_ID=
# ELO_UPDATE_CHANNEL_ID: channel where /mm finish posts the per-player ELO change breakdown.
ELO_UPDATE_CHANNEL_ID=

# ------------------------------------------------------------
# Database (Supabase Postgres) - replaces the old SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY REST-based setup. Run schema.sql once on a
# fresh Supabase project, then paste its "Session pooler" connection
# string here (Project Settings -> Database -> Connection string ->
# Session pooler). Session pooler is recommended over the direct
# connection because it works over IPv4, which most bot hosts
# (including Discloud) require.
# ------------------------------------------------------------
DATABASE_URL=
# ------------------------------------------------------------
# Matchmaking VIP/VIP+ (purchase happens on the site; the bot only
# applies/removes these Discord roles). Must be the SAME IDs configured
# in DISCORD_VIP_ROLE_ID / DISCORD_VIP_PLUS_ROLE_ID in nvl-site's
# .env.local.
# ------------------------------------------------------------
VIP_ROLE_ID=
VIP_PLUS_ROLE_ID=

# Public site URL, used to build the "Buy VIP on the site" link shown
# in /mm vip.
NVL_SITE_URL=

# ------------------------------------------------------------
# Official Match Channels (used by cogs.schedule and the site)
# ------------------------------------------------------------
# Channel where #match-schedule embeds are posted (site posts this on match create/edit)
MATCH_SCHEDULE_CHANNEL_ID=1546600993721155675
# Channel where "Click here to join" embeds are posted when a match starts
MATCH_LINKS_CHANNEL_ID=1544780635384578061
# Channel for stream alerts (Live matches with a stream link)
STREAM_ALERT_CHANNEL_ID=1545074917639323768
# Role pinged in stream alert channel
STREAM_ALERT_ROLE_ID=1544780634411765886
# Channel for final match result embeds
MATCH_RESULTS_CHANNEL_ID=1544780635384578062

# ------------------------------------------------------------
# Staff Discord Role IDs (applied automatically on site approval)
# ------------------------------------------------------------
STAFF_REFEREE_ROLE_ID=1544780634441121827
STAFF_STREAMER_ROLE_ID=1544780634441121826
STAFF_STAT_TRACKER_ROLE_ID=1548018986204139611

# ------------------------------------------------------------
# Internal secret shared between bot and site (referee ratings)
# Generate any random string, set same value in Vercel env vars
# ------------------------------------------------------------
BOT_INTERNAL_SECRET=
